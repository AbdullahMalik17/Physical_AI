## Terrain Adaptation

### Foot Force Sensing

```python
def get_foot_contact_forces(self):
    """Read force sensors on feet"""
    left_forces = []
    right_forces = []

    # Get contact points from PyBullet
    contact_points = p.getContactPoints(self.robot_id)

    for cp in contact_points:
        link_id = cp[3]
        normal_force = cp[9]

        if link_id == self.left_foot_id:
            left_forces.append(normal_force)
        elif link_id == self.right_foot_id:
            right_forces.append(normal_force)

    return sum(left_forces), sum(right_forces)

def is_foot_in_contact(self, foot_side, force_threshold=10.0):
    """Detect foot contact with ground"""
    left_force, right_force = self.get_foot_contact_forces()

    if foot_side == 'left':
        return left_force > force_threshold
    else:
        return right_force > force_threshold
```

### Uneven Terrain Walking

```python
def adjust_gait_for_slope(self, slope_angle):
    """Modify step length and CoM height for slopes"""
    # Shorter steps on slopes
    base_step_length = 0.4
    step_length = base_step_length * np.cos(slope_angle)

    # Lower CoM for stability
    base_com_height = 0.8
    com_height = base_com_height - 0.1 * abs(slope_angle)

    return step_length, com_height

def detect_terrain_slope(self):
    """Estimate ground slope from foot orientations"""
    left_foot_orientation = p.getLinkState(self.robot_id, self.left_foot_id)[1]
    right_foot_orientation = p.getLinkState(self.robot_id, self.right_foot_id)[1]

    # Convert quaternions to Euler angles
    left_pitch = p.getEulerFromQuaternion(left_foot_orientation)[1]
    right_pitch = p.getEulerFromQuaternion(right_foot_orientation)[1]

    # Average pitch
    slope_angle = (left_pitch + right_pitch) / 2.0

    return slope_angle
```

