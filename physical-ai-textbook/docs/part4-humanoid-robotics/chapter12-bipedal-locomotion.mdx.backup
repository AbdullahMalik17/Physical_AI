## Fall Detection & Recovery

### Fall Detection Criteria

**1. ZMP Margin:**
```python
def zmp_stability_margin(self, zmp, support_polygon):
    """Distance from ZMP to polygon edge (negative = unstable)"""
    from shapely.geometry import Point, Polygon

    zmp_point = Point(zmp[:2])
    support_poly = Polygon(support_polygon)

    if support_poly.contains(zmp_point):
        # Distance to nearest edge (positive = safe)
        return zmp_point.distance(support_poly.boundary)
    else:
        # Outside polygon (negative = falling)
        return -zmp_point.distance(support_poly)

def is_falling(self, margin_threshold=0.01):
    """Detect if robot is falling"""
    margin = self.zmp_stability_margin(self.zmp, self.support_polygon)
    return margin < margin_threshold
```

**2. Angular Momentum:**
```python
def compute_angular_momentum(self):
    """Compute total angular momentum about CoM"""
    L = np.zeros(3)

    for i in range(self.num_links):
        # Link linear and angular velocity
        v_i, omega_i = p.getLinkState(self.robot_id, i, computeLinkVelocity=1)[6:8]
        m_i = p.getDynamicsInfo(self.robot_id, i)[0]
        I_i = np.diag(p.getDynamicsInfo(self.robot_id, i)[2])  # Inertia tensor

        # r_i relative to CoM
        r_i = p.getLinkState(self.robot_id, i)[0] - self.com

        # Angular momentum: L = r × mv + Iω
        L += np.cross(r_i, m_i * np.array(v_i))
        L += I_i @ np.array(omega_i)

    return L

def is_angular_momentum_excessive(self, threshold=10.0):
    """Check if robot is spinning uncontrollably"""
    L = self.compute_angular_momentum()
    return np.linalg.norm(L) > threshold
```

### Recovery Strategies

**1. Ankle Strategy (Small perturbations):**
```python
def ankle_strategy_recovery(self, zmp_error):
    """Torque at ankles to shift ZMP"""
    # Proportional control
    K_ankle = 100.0  # N⋅m per meter of ZMP error
    ankle_torque = -K_ankle * zmp_error

    # Apply torque to both ankles
    self.apply_joint_torque('left_ankle_pitch', ankle_torque)
    self.apply_joint_torque('right_ankle_pitch', ankle_torque)
```

**2. Hip Strategy (Medium perturbations):**
```python
def hip_strategy_recovery(self, com_error):
    """Move hips to shift CoM"""
    # PD control
    K_p = 200.0
    K_d = 20.0

    hip_torque = -K_p * com_error - K_d * self.com_velocity

    self.apply_joint_torque('hip_pitch', hip_torque)
```

**3. Step Strategy (Large perturbations):**
```python
def step_strategy_recovery(self, capture_point):
    """Take a step to the capture point"""
    # Determine which foot to step with
    left_foot_pos = self.get_foot_position('left')
    right_foot_pos = self.get_foot_position('right')

    dist_left = np.linalg.norm(capture_point - left_foot_pos)
    dist_right = np.linalg.norm(capture_point - right_foot_pos)

    # Step with closer foot
    if dist_left < dist_right:
        self.plan_step('left', capture_point)
    else:
        self.plan_step('right', capture_point)

def plan_step(self, foot_side, target_pos):
    """Plan swing trajectory for foot"""
    # Cubic Bezier curve for smooth swing
    t = np.linspace(0, 1, 100)
    swing_height = 0.05  # 5cm clearance

    start = self.get_foot_position(foot_side)
    end = target_pos

    # Control points for Bezier curve
    p0 = start
    p1 = start + np.array([0, 0, swing_height])
    p2 = end + np.array([0, 0, swing_height])
    p3 = end

    # Bezier curve
    trajectory = (1-t)**3 * p0[:, None] + \
                 3*(1-t)**2*t * p1[:, None] + \
                 3*(1-t)*t**2 * p2[:, None] + \
                 t**3 * p3[:, None]

    return trajectory.T
```

