## Gait Generation

### Walking Cycle Phases

**Single Support Phase (SSP):**
- One foot on ground (stance foot)
- Other foot swinging forward (swing foot)
- Duration: ~60% of cycle

**Double Support Phase (DSP):**
- Both feet on ground
- Weight transfer from rear to front foot
- Duration: ~20% of cycle (each, 2 transitions per cycle)

### Linear Inverted Pendulum Model (LIPM)

**Assumptions:**
1. CoM height is constant: $z_{\text{CoM}} = h$
2. All mass concentrated at CoM
3. Massless telescopic legs

**Equation of motion (2D):**

$$
\ddot{x}_{\text{CoM}} = \frac{g}{h} (x_{\text{CoM}} - x_{\text{ZMP}})
$$

**Solution (exponential dynamics):**

$$
x_{\text{CoM}}(t) = x_{\text{ZMP}} + (x_0 - x_{\text{ZMP}}) \cosh(\omega t) + \frac{\dot{x}_0}{\omega} \sinh(\omega t)
$$

Where $\omega = \sqrt{g/h}$ is the natural frequency

### Python Implementation: LIPM Walking

```python
#!/usr/bin/env python3
import numpy as np
import matplotlib.pyplot as plt

class LIPMWalking:
    def __init__(self, com_height=0.8, step_length=0.4, step_duration=0.8):
        self.h = com_height        # CoM height (m)
        self.omega = np.sqrt(9.81 / self.h)  # Natural frequency
        self.step_length = step_length
        self.step_duration = step_duration
        self.dsp_ratio = 0.2       # Double support phase ratio

    def lipm_dynamics(self, x0, xd0, x_zmp, t):
        """
        Solve LIPM dynamics

        Args:
            x0: Initial CoM position
            xd0: Initial CoM velocity
            x_zmp: ZMP position (constant during phase)
            t: Time

        Returns:
            (x_com, xd_com): CoM position and velocity
        """
        w = self.omega
        x_com = x_zmp + (x0 - x_zmp) * np.cosh(w * t) + (xd0 / w) * np.sinh(w * t)
        xd_com = (x0 - x_zmp) * w * np.sinh(w * t) + xd0 * np.cosh(w * t)
        return x_com, xd_com

    def generate_footsteps(self, num_steps=10):
        """Generate footstep positions"""
        footsteps = []
        for i in range(num_steps):
            side = 'left' if i % 2 == 0 else 'right'
            x = i * self.step_length
            y = 0.1 if side == 'left' else -0.1  # Foot spacing
            footsteps.append({'x': x, 'y': y, 'side': side})

        return footsteps

    def generate_zmp_trajectory(self, footsteps):
        """Generate ZMP trajectory from footsteps"""
        zmp_x = []
        zmp_y = []
        time = []

        t = 0.0
        for i, step in enumerate(footsteps):
            # DSP: ZMP between current and next foot
            if i < len(footsteps) - 1:
                dsp_duration = self.step_duration * self.dsp_ratio
                zmp_x_dsp = np.linspace(step['x'], footsteps[i+1]['x'], 20)
                zmp_y_dsp = np.linspace(step['y'], footsteps[i+1]['y'], 20)
                time_dsp = np.linspace(t, t + dsp_duration, 20)

                zmp_x.extend(zmp_x_dsp)
                zmp_y.extend(zmp_y_dsp)
                time.extend(time_dsp)

                t += dsp_duration

            # SSP: ZMP at current foot
            ssp_duration = self.step_duration * (1 - 2 * self.dsp_ratio)
            zmp_x_ssp = [step['x']] * 20
            zmp_y_ssp = [step['y']] * 20
            time_ssp = np.linspace(t, t + ssp_duration, 20)

            zmp_x.extend(zmp_x_ssp)
            zmp_y.extend(zmp_y_ssp)
            time.extend(time_ssp)

            t += ssp_duration

        return np.array(time), np.array(zmp_x), np.array(zmp_y)

    def simulate_walking(self, num_steps=10):
        """Simulate LIPM walking"""
        footsteps = self.generate_footsteps(num_steps)
        time, zmp_x, zmp_y = self.generate_zmp_trajectory(footsteps)

        # Simulate CoM trajectory
        x_com = [0.0]
        xd_com = [0.0]
        dt = time[1] - time[0]

        for i in range(1, len(time)):
            x, xd = self.lipm_dynamics(
                x_com[-1], xd_com[-1], zmp_x[i], dt
            )
            x_com.append(x)
            xd_com.append(xd)

        return time, np.array(x_com), zmp_x, footsteps

    def plot_walking(self):
        """Visualize walking simulation"""
        time, x_com, zmp_x, footsteps = self.simulate_walking()

        fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(12, 8))

        # Plot CoM and ZMP trajectories
        ax1.plot(time, x_com, 'b-', linewidth=2, label='CoM')
        ax1.plot(time, zmp_x, 'r--', linewidth=2, label='ZMP')

        # Plot footsteps
        for step in footsteps:
            ax1.axvline(step['x'] / self.step_length * self.step_duration,
                       color='gray', linestyle=':', alpha=0.3)

        ax1.set_xlabel('Time (s)')
        ax1.set_ylabel('Position (m)')
        ax1.set_title('LIPM Walking: CoM and ZMP Trajectories')
        ax1.legend()
        ax1.grid(True)

        # Plot CoM velocity
        xd_com = np.gradient(x_com, time)
        ax2.plot(time, xd_com, 'g-', linewidth=2)
        ax2.set_xlabel('Time (s)')
        ax2.set_ylabel('Velocity (m/s)')
        ax2.set_title('CoM Velocity')
        ax2.grid(True)

        plt.tight_layout()
        plt.show()

# Example usage
if __name__ == '__main__':
    walker = LIPMWalking(com_height=0.8, step_length=0.4, step_duration=0.8)
    walker.plot_walking()
```

